# 复制本文件为 gmail.properties 并填入真实值（gmail.properties 已被 .gitignore 忽略，不会入库）
#
# from        发件 Gmail 地址
# appPassword 16 位应用专用密码，不含空格（https://myaccount.google.com/apppasswords，需先开两步验证）
# to          默认收件人
from=you@gmail.com
appPassword=xxxxxxxxxxxxxxxx
to=someone@example.com

# 可选：走本地 SOCKS5 代理出站（直连 smtp.gmail.com 超时/被拦时填，如 Clash/v2rayN 的 socks 端口）
# socksHost=127.0.0.1
# socksPort=1080
